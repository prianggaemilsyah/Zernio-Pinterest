{
  "name": "pinterest-dashboard",
  "version": "1.0.0",
  "description": "Full Pinterest Dashboard via Zernio API",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "web": "node server.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.zernio.pinterest-dashboard",
    "productName": "Pinterest Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../API_Zernio_Pinterest",
        "to": "API_Zernio_Pinterest"
      }
    ],
    "win": {
      "target": "portable",
      "icon": null
    },
    "portable": {
      "artifactName": "Pinterest-Dashboard-${version}-Portable.exe"
    }
  }
}
